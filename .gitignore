# ============================================================
# .gitignore — git 스냅샷(커밋)에서 제외할 것들
#   원칙: "소스에서 다시 만들어낼 수 있는 산출물"은 제외,
#         "손으로 만든 것(코드·설정·지도)"만 보관.
# ============================================================

# colcon 빌드 산출물 3형제 — colcon build 가 언제든 재생성
build/
install/
log/

# 남의 저장소를 clone 한 외부 패키지 — 필요하면 git clone 으로 재획득
# (우리 코드가 아니므로 우리 스냅샷에 안 넣는 게 관례)
src/sllidar_ros2/

# 파이썬 캐시
__pycache__/
*.pyc
