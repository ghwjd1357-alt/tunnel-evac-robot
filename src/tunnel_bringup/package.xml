<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunnel_bringup</name>
  <version>0.0.0</version>
  <description>실차(Jetson) 전용 bringup — 런치·파라미터·URDF. 시뮬 자산(tunnel_sim)은 건드리지 않는다.</description>
  <maintainer email="ghwjd1357@gmail.com">minwoo</maintainer>
  <license>Apache-2.0</license>

  <!-- ===== readiness_gate 노드가 실제로 import 하는 것 ===== -->
  <depend>rclpy</depend>
  <!-- 토픽 타입을 그래프에서 조회해 동적으로 구독 (특정 메시지 타입에 묶이지 않게) -->
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- TF 연결 확인 -->
  <depend>tf2_ros_py</depend>
  <!-- Nav2 lifecycle 노드가 ACTIVE 인지 확인 (<노드>/get_state 서비스) -->
  <depend>lifecycle_msgs</depend>

  <!-- ===== 런치가 기동하는 노드들 (실행 시점 의존) ===== -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>mission_manager</exec_depend>

  <!-- ⚠ micro_ros_agent 는 일부러 여기 넣지 않는다.
       rosdistro 배포 패키지가 아니라 Jetson 에서 소스 빌드하는 물건이라,
       선언하면 `rosdep install` 이 "찾을 수 없는 의존성"으로 실패한다.
       설치는 R0 준비물 — 없으면 real_bringup 을 micro_ros:=false 로 띄운다. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
