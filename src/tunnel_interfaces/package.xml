<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunnel_interfaces</name>
  <version>1.0.0</version>
  <description>역할 A ↔ 역할 B 공용 인터페이스. `/detections` V1 계약(Detection3D · Detection3DArray)만 담는다. 계약 정본 = docs/PROJECT_CONTEXT.md §4.1</description>
  <maintainer email="ghwjd1357@gmail.com">minwoo</maintainer>
  <license>Apache-2.0</license>

  <!-- ===== .msg → 코드 생성 =====
       🔴 이 패키지는 노드를 갖지 않는다. 메시지 정의만 소유한다.
       역할 B(~/percep_ws)는 이것을 읽기 전용으로 참조하며 복사본을 두지 않는다
       (합의사항 N6 — overlay 에 두 벌이 빌드되면 필드가 갈라져도 런타임 에러가
        아니라 '값이 틀린 수신'이 된다). -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Detection3D 가 참조하는 표준 타입 -->
  <depend>std_msgs</depend>          <!-- Header -->
  <depend>sensor_msgs</depend>       <!-- RegionOfInterest (bbox) -->
  <depend>geometry_msgs</depend>     <!-- Point (position) -->

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 🔴 format 3 스키마는 순서를 강제한다 — dependency 구역이 끝난 **뒤**에
       member_of_group, 그다음 export 다. 초판은 member_of_group 을 test_depend
       앞에 둬서 ament_xmllint 가 거부했다(검토 §80.3):
         "Element 'test_depend': This element is not expected.
          Expected is one of ( member_of_group, export )"
       빌드와 ros2 interface show 는 통과했기 때문에 조용했고, colcon test 를
       돌려야만 드러났다. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
