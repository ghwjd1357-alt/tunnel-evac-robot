<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunnel_sim</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="minwoo@todo.todo">minwoo</maintainer>
  <license>TODO: License declaration</license>

  <!-- 실제 import 기준 명시 (07-19 검토 반영): 지금 PC 는 다른 패키지가 깔아둔 걸
       얻어 쓰지만, 새 Jetson/CI 의 rosdep install 재현성을 위해 전부 선언 -->
  <depend>gazebo_ros</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>gazebo_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 런치가 포함하는 외부 스택 (slam.launch → slam_toolbox, nav2_bringup 등) -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- mission.launch.py 가 mission_manager 의 share·노드를 직접 실행 (07-19 Codex §3.4:
       같은 워크스페이스라 티가 안 났지만, 패키지 단위 설치·Jetson 이식 시 재현성 구멍) -->
  <exec_depend>mission_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
